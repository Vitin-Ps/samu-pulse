# ============================================================
# SAMU Pulse — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA coloque valores reais neste arquivo!
# ============================================================

# --- URL do frontend (usada nos links do e-mail) ---
SITE_URL=http://localhost:3000

# --- Banco de Dados ---
DB_URL=jdbc:postgresql://localhost:5432/medinsight
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
# Mínimo 32 caracteres para HS256
JWT_SECRET=
# Expiração em milissegundos (604800000 = 7 dias)
JWT_EXPIRATION_MS=604800000

# --- Servidor ---
SERVER_PORT=8080

# --- Debug (true em local/dev, false ou ausente em produção) ---
DEBUG_ERRORS=false

URL_UPLOADS=docs_upload

SENHA_FIRST_ACESSO=123456

# --- E-mail SMTP ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
# --- Integrações futuras ---
# SOME_API_KEY=
# SOME_API_SECRET=
